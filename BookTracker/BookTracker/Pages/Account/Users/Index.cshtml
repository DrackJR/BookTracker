@page
@model BookTracker.Pages.Account.Users.IndexModel
@{
}
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Users</h2>
        <a asp-page="Create" class="btn btn-primary">
            Create User
        </a>
    </div>

    <div class="row g-4">

        @foreach (var user in Model.Users)
        {
            <div class="col-md-4 col-lg-3">

                <div class="card h-100 shadow-sm">

                    <div class="card-body text-center">
                        @if (user.Avatar != null && user.Avatar.Length > 0)
                        {
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(user.Avatar)"
                                 style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover;" />
                        }
                        else
                        {
                            <div style="width: 80px; height: 80px; border-radius: 50%; background-color: #6c757d; margin: 0 auto; line-height: 80px; color: white; font-size: 32px;">
                                👤
                            </div>
                        }
                        <p class="text-muted">@user.Email</p>
                        <span class="badge bg-secondary">@user.Role</span>

                        <h5 class="card-title text-truncate">
                            @user.Email
                        </h5>

                        <p class="card-text">
                            Role:
                            <span class="badge bg-secondary">
                                @user.Role
                            </span>
                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <div class="d-flex justify-content-between">

                            <a asp-page="Details"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            <a asp-page="Edit"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <a asp-page="Delete"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>