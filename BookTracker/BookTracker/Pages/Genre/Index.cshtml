@page
@model BookTracker.Pages.Genre.IndexModel
@{
    ViewData["Title"] = "Список жанров";
}

<div class="container mt-4">
    <div class="row justify-content-between align-items-center mb-4">
        <div class="col">
            <h1 class="h3 mb-0">Список жанров</h1>
        </div>
        <div class="col-auto">
            <a asp-page="Create" class="btn btn-primary">Добавить жанр</a>
        </div>
    </div>

    <div class="row">
        @foreach (var genre in Model.Genres)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@genre.Title</h5>

                        @if (!string.IsNullOrEmpty(genre.Description))
                        {
                            <p class="card-text text-muted small">
                                @(genre.Description.Length > 100 ? genre.Description.Substring(0, 100) + "..." : genre.Description)
                            </p>
                        }
                        else
                        {
                            <p class="card-text text-muted fst-italic small">Нет описания</p>
                        }

                        <hr />
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <small class="text-muted">ID: @genre.Id</small>
                            <div class="btn-group btn-group-sm">
                                <a asp-page="Details" asp-route-id="@genre.Id" class="btn btn-outline-primary">Открыть</a>
                                <a asp-page="Edit" asp-route-id="@genre.Id" class="btn btn-outline-secondary">Изменить</a>
                                <a asp-page="Delete" asp-route-id="@genre.Id" class="btn btn-outline-danger">Удалить</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Genres.Any())
    {
        <div class="alert alert-info text-center">
            Список жанров пуст. Добавьте первый жанр!
        </div>
    }
</div>