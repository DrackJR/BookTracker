@page
@model BookTracker.Pages.Books.IndexModel
@{
    ViewData["Title"] = "Список книг";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Список книг</h4>
                    <a asp-page="Create" class="btn btn-light btn-sm">Добавить книгу</a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Название</th>
                                    <th>Автор</th>
                                    <th>Год</th>
                                    <th>Жанр</th>
                                    <th>Заметки</th>
                                    <th>Дата добавления</th>
                                    <th>Статус</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var book in Model.Books)
                                {
                                    <tr>
                                        <td>@book.Name</td>
                                        <td>@book.Author?.Name</td>
                                        <td>@book.Year</td>
                                        <td>@book.Genre?.Name</td>
                                        <td>@(book.Notes?.Length > 30 ? book.Notes.Substring(0, 30) + "..." : book.Notes)</td>
                                        <td>@book.AddDateTime.ToString("dd.MM.yyyy")</td>
                                        <td>@book.Status</td>
                                        <td>
                                            <a asp-page="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">Открыть</a>
                                            <a asp-page="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                                            <a asp-page="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
<!-- Подключение SignalR для обновления карточек книг в реальном времени -->
<script>
    // Создаём подключение к хабу BookHub
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/bookHub") // Путь к хабу на сервере
        .build();

    // Слушаем событие "BookUpdated", отправляемое сервером
    connection.on("BookUpdated", function (book) {
        // Ищем существующую карточку по id
        const existingCard = document.getElementById("book-" + book.id);

        // HTML для новой/обновлённой карточки
        const html = `
            <div class="card h-100 shadow-sm" id="book-${book.id}">
                <div class="card-body">
                    <h5 class="card-title text-truncate">📚 ${book.Name}</h5>

                    <p class="card-text mb-1">Автор: <span class="badge bg-secondary">${book.Author?.Name}</span></p>
                    <p class="card-text mb-2">Год: <span class="badge bg-info">${book.year}</span></p>
                     <p class="card-text mb-1">Жанр: <span class="badge bg-secondary">${book.Genre?.Name}</span></p>
                    <p class="card-text mb-2">Заметки: <span class="badge bg-info">${book.notes}</span></p>
                     <p class="card-text mb-1">Дата добавления: <span class="badge bg-secondary">${book.AddDateTime}</span></p>
                    <p class="card-text mb-2">Статус: <span class="badge bg-info">${book.Status}</span></p>
                    <div class="d-flex justify-content-between">
                        <a href="/Books/Details?id=${book.id}" class="btn btn-sm btn-info">Открыть</a>
                        <a href="/Books/Edit?id=${book.id}" class="btn btn-sm btn-warning">Изменить</a>
                        <a href="/Books/Delete?id=${book.id}" class="btn btn-sm btn-danger">Удалить</a>
                    </div>
                </div>
            </div>
        `;

        if (existingCard) {
            // Если карточка уже есть — заменяем старую на новую
            existingCard.outerHTML = html;
        } else {
            // Если карточка новая — создаём div.col и добавляем в контейнер
            const container = document.querySelector(".row");
            const wrapper = document.createElement("div");
            wrapper.className = "col-sm-6 col-md-4 col-lg-3";
            wrapper.innerHTML = html;
            container.appendChild(wrapper);
        }
    });

    // Запуск подключения
    connection.start().catch(err => console.error(err.toString()));
</script>