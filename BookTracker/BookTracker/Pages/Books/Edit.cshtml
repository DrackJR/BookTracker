@page
@using BookTracker.Model
@model BookTracker.Pages.Books.EditModel
@{
}

<h1>Редактировать книгу</h1>

<form method="post">
    <input type="hidden" asp-for="Book.Id" />

    <div>
        <label>Название</label><br />
        <input asp-for="Book.Title" />
    </div>

    <div>
        <label>Автор</label><br />
        <input asp-for="Book.Author.Name" />
    </div>

    <div>
        <label>Год</label><br />
        <input asp-for="Book.Year" type="number" />
    </div>

    <div>
        <label>Жанр</label><br />
        <input asp-for="Book.Genre.Name" />
    </div>
    <div>
        <label>Заметки</label><br />
        <input asp-for="Book.Notes" type="text" />
    </div>

    <div>
        <label>Дата добавления</label><br />
        <input asp-for="Book.AddDateTime" type="datetime" />
    </div>

    <div>
        <label>Статус</label><br />
        <select asp-for="Book.Status" asp-items="Html.GetEnumSelectList<BookStatus>()"></select>
    </div>

    <div>
        <p>
        </p>
    </div>

    <button type="submit">Сохранить</button>
</form>

<a asp-page="Index">Назад</a>