@page
@using BookTracker.Model
@model BookTracker.Pages.Books.CreateModel
@{
    ViewData["Title"] = "Добавить книгу";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Добавить книгу</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Book.Title" class="form-label">Название</label>
                            <input asp-for="Book.Title" class="form-control" />
                            <span asp-validation-for="Book.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Book.AuthorId" class="form-label">Автор</label>
                            <select asp-for="Book.AuthorId" class="form-select" asp-items="Model.AuthorList">
                                <option value="">Выберите автора</option>
                            </select>
                            <span asp-validation-for="Book.AuthorId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Book.Year" class="form-label">Год издания</label>
                            <input asp-for="Book.Year" type="number" class="form-control" />
                            <span asp-validation-for="Book.Year" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Book.GenreId" class="form-label">Жанр</label>
                            <select asp-for="Book.GenreId" class="form-select" asp-items="Model.GenreList">
                                <option value="">Выберите жанр</option>
                            </select>
                            <span asp-validation-for="Book.GenreId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Book.Notes" class="form-label">Заметки</label>
                            <textarea asp-for="Book.Notes" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Book.Status" class="form-label">Статус</label>
                            <select asp-for="Book.Status" class="form-select" asp-items="Html.GetEnumSelectList<BookStatus>()">
                                <option value="">Выберите статус</option>
                            </select>
                            <span asp-validation-for="Book.Status" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Book.AddDateTime" class="form-label">Дата добавления</label>
                            <input asp-for="Book.AddDateTime" type="date" class="form-control" />
                            <span asp-validation-for="Book.AddDateTime" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="Index" class="btn btn-secondary">Назад</a>
                            <button type="submit" class="btn btn-success">Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}