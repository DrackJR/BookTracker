@page
@model BookTracker.Pages.Author.IndexModel
@{
    ViewData["Title"] = "Список авторов";
}

<div class="container mt-4">
    <div class="row justify-content-between align-items-center mb-4">
        <div class="col">
            <h1 class="h3 mb-0">Список авторов</h1>
        </div>
        <div class="col-auto">
            <a asp-page="Create" class="btn btn-primary">Добавить автора</a>
        </div>
    </div>

    <div class="row">
        @foreach (var author in Model.Authors)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@author.Name</h5>

                        @if (!string.IsNullOrEmpty(author.Biografy))
                        {
                            <p class="card-text text-muted small">
                                @(author.Biografy.Length > 100 ? author.Biografy.Substring(0, 100) + "..." : author.Biografy)
                            </p>
                        }
                        else
                        {
                            <p class="card-text text-muted fst-italic small">Нет биографии</p>
                        }

                        <hr />
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <small class="text-muted">ID: @author.Id</small>
                            <div class="btn-group btn-group-sm">
                                <a asp-page="Details" asp-route-id="@author.Id" class="btn btn-outline-primary">Открыть</a>
                                <a asp-page="Edit" asp-route-id="@author.Id" class="btn btn-outline-secondary">Изменить</a>
                                <a asp-page="Delete" asp-route-id="@author.Id" class="btn btn-outline-danger">Удалить</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Authors.Any())
    {
        <div class="alert alert-info text-center">
            Список авторов пуст. Добавьте первого автора!
        </div>
    }
</div>